<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="leo_visualization">

  <xacro:arg name="mecanum_wheels" default="false"/>

  <xacro:include filename="$(find leo_description)/urdf/macros.xacro"/>

  <!--
    Visualization-only Leo model.

    Bullet remains authoritative for physics and publishes odom -> base_link.
    Prefixing every visual link avoids duplicate TF ownership for base_scan and
    imu_frame. Joint names intentionally remain unprefixed so the existing
    /joint_states message animates the four wheel meshes.
  -->
  <xacro:leo default_antenna="true"
             rockers_fixed="true"
             footprint_link="false"
             link_prefix="visual_"
             joint_prefix=""
             mecanum_wheels="$(arg mecanum_wheels)"/>

</robot>
