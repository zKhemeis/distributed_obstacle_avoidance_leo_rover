Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /pybullet_markers
      Name: Robot and obstacles
    - Class: rviz_default_plugins/LaserScan
      Color: 0; 255; 255
      Enabled: true
      Name: LiDAR
      Size (Pixels): 2
      Style: Points
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rl_goal
      Name: RL goal
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Axes: true
      Show Arrows: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Field of View: 0.785398
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Fixed Map 3D
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: map
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1200
